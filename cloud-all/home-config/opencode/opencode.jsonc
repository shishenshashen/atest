{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [
    "auto"
  ],
  "provider": {
    "auto": {
      "name": "auto",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://app.manifest.build/v1"
      },
      "models": {
        "auto": {
          "name": "auto"
        }
      }
    },
    "manifest": {
      "name": "Manifest",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://app.manifest.build/v1"
      },
      "models": {
        "auto": {
          "name": "manifestauto"
        }
      }
    }
  }
}