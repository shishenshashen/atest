# Hermes 同步 .gitignore
# 凭证
.env
.env.backups/
*.key
*.pem
.ssh/

# 临时/缓存
__pycache__/
*.pyc
*.pyo
*~
*.tmp
*.lock
.DS_Store
Thumbs.db

# 大二进制: 不传 (会单传压缩版)
state.db
state.db-shm
state.db-wal

# 大目录: 已 exclude (lsp/cache/uploads 等)
# 仓内 .git
github-mirror/*/.git/
hermes-agent/.git/

# 虚拟环境
.venv/
venv/
node_modules/
